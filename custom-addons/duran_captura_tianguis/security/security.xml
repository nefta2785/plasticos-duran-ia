<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Privilegio propio: en la ficha del usuario aparece como un selector
         aparte ("No" / "Usuario") dentro de Ventas, sin mezclarse con los
         niveles de Ventas. -->
    <record id="res_groups_privilege_captura_tianguis" model="res.groups.privilege">
        <field name="name">Captura tianguis</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_captura_tianguis" model="res.groups">
        <field name="name">Usuario</field>
        <field name="privilege_id" ref="res_groups_privilege_captura_tianguis"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Puede usar la pantalla /captura para levantar pedidos en el tianguis.</field>
    </record>

    <!-- Bitácora de entregas: quien captura solo ve las suyas; el gerente de
         Ventas ve todas. Nadie la modifica ni la borra desde la interfaz. -->
    <record id="regla_captura_entrega_propias" model="ir.rule">
        <field name="name">Entregas en tianguis: solo las propias</field>
        <field name="model_id" ref="model_duran_captura_entrega"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_captura_tianguis'))]"/>
    </record>

    <record id="regla_captura_entrega_linea_propias" model="ir.rule">
        <field name="name">Productos entregados en tianguis: solo los propios</field>
        <field name="model_id" ref="model_duran_captura_entrega_linea"/>
        <field name="domain_force">[('entrega_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_captura_tianguis'))]"/>
    </record>

    <record id="regla_captura_entrega_todas" model="ir.rule">
        <field name="name">Entregas en tianguis: todas</field>
        <field name="model_id" ref="model_duran_captura_entrega"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>

    <record id="regla_captura_entrega_linea_todas" model="ir.rule">
        <field name="name">Productos entregados en tianguis: todos</field>
        <field name="model_id" ref="model_duran_captura_entrega_linea"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>

    <record id="regla_captura_entrega_compania" model="ir.rule">
        <field name="name">Entregas en tianguis: multicompañía</field>
        <field name="model_id" ref="model_duran_captura_entrega"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Bitácora de cobros: mismas reglas que la de entregas. -->
    <record id="regla_captura_cobro_propios" model="ir.rule">
        <field name="name">Cobros en tianguis: solo los propios</field>
        <field name="model_id" ref="model_duran_captura_cobro"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_captura_tianguis'))]"/>
    </record>

    <record id="regla_captura_cobro_todos" model="ir.rule">
        <field name="name">Cobros en tianguis: todos</field>
        <field name="model_id" ref="model_duran_captura_cobro"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>

    <record id="regla_captura_cobro_linea_propios" model="ir.rule">
        <field name="name">Documentos de cobros en tianguis: solo los propios</field>
        <field name="model_id" ref="model_duran_captura_cobro_linea"/>
        <field name="domain_force">[('cobro_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_captura_tianguis'))]"/>
    </record>

    <record id="regla_captura_cobro_linea_todos" model="ir.rule">
        <field name="name">Documentos de cobros en tianguis: todos</field>
        <field name="model_id" ref="model_duran_captura_cobro_linea"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>

    <record id="regla_captura_cobro_compania" model="ir.rule">
        <field name="name">Cobros en tianguis: multicompañía</field>
        <field name="model_id" ref="model_duran_captura_cobro"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
