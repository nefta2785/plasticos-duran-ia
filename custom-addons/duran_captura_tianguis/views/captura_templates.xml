<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Página independiente (sin el cliente web del backend), pensada para
         celular. Todo el contenido lo dibuja static/src/captura.js. -->
    <template id="captura_page" name="Captura tianguis">&lt;!DOCTYPE html&gt;
<html lang="es">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
        <meta name="theme-color" content="#0b3d91"/>
        <title>Captura tianguis</title>
        <link rel="stylesheet" t-attf-href="/duran_captura_tianguis/static/src/captura.css?v=#{version}"/>
        <script t-attf-src="/duran_captura_tianguis/static/src/captura.js?v=#{version}" defer="defer"></script>
    </head>
    <body t-att-data-salir="'1' if puede_salir else None">
        <header class="barra">
            <!-- Fila de botones: "Regresar" (o "Salir" en Inicio) a la izquierda
                 e INICIO a la derecha; el título va debajo, a todo lo ancho. -->
            <div id="barra-botones" class="barra-botones">
                <button type="button" id="btn-regresar" class="btn-regresar">‹ Regresar</button>
                <button type="button" id="btn-inicio" class="btn-inicio" hidden="hidden"><span aria-hidden="true">🏠</span> INICIO</button>
            </div>
            <!-- En qué operación se está (PEDIDO, ENTREGA…): siempre en el mismo
                 lugar, con el color de su barra. Oculta en Inicio. -->
            <p id="operacion" class="operacion" hidden="hidden"></p>
            <div class="barra-textos">
                <h1 id="titulo" class="titulo">Captura</h1>
                <p id="subtitulo" class="subtitulo" hidden="hidden"></p>
            </div>
        </header>
        <nav id="categorias" class="categorias" role="tablist" aria-label="Categorías" hidden="hidden"></nav>
        <main id="contenido" class="contenido" aria-live="polite">
            <p class="aviso">Cargando…</p>
            <noscript><p class="aviso">Esta pantalla necesita JavaScript activado.</p></noscript>
        </main>
        <!-- Franja de abajo de Pedido, Entrega y Cobro: el botón verde con el
             verbo ("REVISAR PEDIDO ›", "✓ ENVIAR PEDIDO"…) y, en la pantalla
             final, el aviso de que todavía falta ese paso. -->
        <footer id="barra-pedido" class="barra-pedido" hidden="hidden">
            <p id="falta-paso" class="falta-paso" role="alert" hidden="hidden"></p>
            <button type="button" id="btn-pedido" class="btn-pedido" disabled="disabled">
                <span id="pedido-accion" class="pedido-accion"></span>
                <span id="pedido-conteo" class="pedido-conteo">Pedido vacío</span>
            </button>
        </footer>
        <!-- Pregunta (en lugar de window.confirm): el botón "Sí" toma su color
             de quien pregunta (rojo para borrar, verde para enviar ahora). -->
        <div id="modal" class="modal-fondo" hidden="hidden">
            <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="modal-titulo modal-texto">
                <p id="modal-titulo" class="modal-titulo" hidden="hidden"></p>
                <p id="modal-texto" class="modal-texto"></p>
                <button type="button" id="modal-si" class="btn"></button>
                <button type="button" id="modal-no" class="btn btn-secundario"></button>
            </div>
        </div>
    </body>
</html>
    </template>

</odoo>
