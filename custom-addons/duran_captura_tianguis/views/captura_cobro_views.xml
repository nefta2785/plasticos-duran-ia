<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Facturas y pago solo para el gerente de Ventas: quien cobra no puede
         leer facturas de otros vendedores ni pagos. -->

    <record id="captura_cobro_view_list" model="ir.ui.view">
        <field name="name">duran.captura.cobro.list</field>
        <field name="model">duran.captura.cobro</field>
        <field name="arch" type="xml">
            <!-- Arqueo: en cada grupo (día, quién cobró) se suman el efectivo
                 recibido y lo que quedó pendiente. -->
            <list string="Resumen de ventas" create="false" edit="false" delete="false">
                <field name="fecha"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="partner_id"/>
                <field name="zona_id"/>
                <field name="tipo"/>
                <field name="invoice_ids" widget="many2many_tags" optional="hide" groups="sales_team.group_sale_manager"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="total_a_cobrar" sum="Total a cobrar"/>
                <field name="monto_recibido" sum="Efectivo recibido"/>
                <field name="saldo_pendiente" sum="Queda pendiente"/>
            </list>
        </field>
    </record>

    <record id="captura_cobro_view_form" model="ir.ui.view">
        <field name="name">duran.captura.cobro.form</field>
        <field name="model">duran.captura.cobro</field>
        <field name="arch" type="xml">
            <form string="Cobro en tianguis" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="zona_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="fecha"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="True"/>
                            <field name="tipo"/>
                            <field name="total_entregado"/>
                            <field name="saldo_anterior"/>
                            <field name="creditos"/>
                            <field name="total_a_cobrar"/>
                            <field name="monto_recibido"/>
                            <field name="saldo_pendiente"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documentos" name="documentos" groups="sales_team.group_sale_manager">
                            <group>
                                <field name="invoice_ids" widget="many2many_tags"/>
                                <field name="payment_id"/>
                            </group>
                            <field name="linea_ids">
                                <list>
                                    <field name="move_id"/>
                                    <field name="tipo"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="saldo_antes"/>
                                    <field name="aplicado" sum="Aplicado"/>
                                    <field name="saldo_despues" sum="Saldo después"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notas" invisible="not nota">
                            <field name="nota"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="captura_cobro_view_search" model="ir.ui.view">
        <field name="name">duran.captura.cobro.search</field>
        <field name="model">duran.captura.cobro</field>
        <field name="arch" type="xml">
            <search string="Resumen de ventas">
                <field name="partner_id"/>
                <field name="zona_id"/>
                <field name="user_id"/>
                <filter string="Mis cobros" name="mis_cobros" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Pagó todo" name="pago_todo" domain="[('tipo', '=', 'todo')]"/>
                <filter string="Pagó una parte" name="pago_parte" domain="[('tipo', '=', 'parte')]"/>
                <filter string="No pagó hoy" name="pago_nada" domain="[('tipo', '=', 'nada')]"/>
                <separator/>
                <!-- 'today' es el día de hoy en la zona horaria de quien consulta. -->
                <filter string="Hoy" name="hoy" domain="[('fecha', '&gt;=', 'today'), ('fecha', '&lt;', 'today +1d')]"/>
                <filter string="Fecha" name="filtro_fecha" date="fecha"/>
                <group>
                    <filter string="Zona" name="agrupar_zona" context="{'group_by': 'zona_id'}"/>
                    <filter string="Cobró" name="agrupar_usuario" context="{'group_by': 'user_id'}"/>
                    <filter string="Día" name="agrupar_dia" context="{'group_by': 'fecha:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="captura_cobro_action" model="ir.actions.act_window">
        <field name="name">Resumen de ventas</field>
        <field name="res_model">duran.captura.cobro</field>
        <field name="view_mode">list,form</field>
        <!-- Arqueo del día: hoy, por día y dentro por quién cobró. -->
        <field name="context">{'search_default_hoy': 1, 'search_default_agrupar_dia': 1, 'search_default_agrupar_usuario': 2}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay nada en el resumen de ventas</p>
            <p>Aquí aparece cada cobro confirmado desde la app de captura (modo Cobro): cuánto se cobró, cuánto quedó pendiente y quién cobró.</p>
        </field>
    </record>

    <menuitem id="captura_cobro_menu"
        name="Resumen de ventas"
        parent="sale.sale_order_menu"
        action="captura_cobro_action"
        groups="sales_team.group_sale_manager,group_captura_tianguis"
        sequence="26"/>

</odoo>
