<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hoja de carga: un renglón por producto y zona con lo pendiente de
         entregar (vista SQL duran.hoja.carga) y la marca de "Acomodado" de hoy.
         Verde: lo marcado alcanza para lo pendiente; naranja: se agregó más
         de lo marcado.
         Abre con las zonas abiertas (expand), se recarga sola y al pie lleva
         "Productos totales: N" (js_class duran_hoja_carga_lista,
         static/src/hoja_carga_lista.js, sobre lista_recarga.js). Pensada
         para caber en 393 px: la zona va solo en el encabezado del grupo. -->
    <record id="hoja_carga_view_list" model="ir.ui.view">
        <field name="name">duran.hoja.carga.list</field>
        <field name="model">duran.hoja.carga</field>
        <field name="arch" type="xml">
            <list string="Hoja de carga" class="o_hoja_carga" js_class="duran_hoja_carga_lista" expand="1"
                  create="false" edit="false" delete="false"
                  decoration-success="estado == 'acomodado'"
                  decoration-warning="estado == 'agregado'">
                <field name="estado" column_invisible="True"/>
                <field name="product_id"/>
                <!-- Total y unidad en una columna ("4 pz", "2,5 kg"); `total` va
                     oculto para el botón. Anchos fijos con el atributo width
                     (column_width_hook.js); el Producto se queda con el resto. -->
                <field name="total" column_invisible="True"/>
                <field name="cantidad_texto" width="52px"/>
                <field name="aviso" width="88px"/>
                <!-- Oculto: solo para el pie "Productos totales: N" (hoja_carga_lista.js),
                     que suma los totales de cada zona (aggregator="sum" en el modelo). -->
                <field name="productos_totales" column_invisible="True"/>
                <!-- Un botón con texto por renglón, en la misma columna (sin width:
                     así Odoo los junta). Gris "Acomodar" y naranja "Por acomodar"
                     marcan con lo que se veía en pantalla; verde "Acomodado" quita la
                     marca. Colores y tamaño en hoja_carga.css; el naranja lleva
                     btn-secondary solo para que Odoo no le ponga btn-link (view_button.js). -->
                <button name="action_acomodado" type="object" string="Acomodar" title="Acomodar"
                        class="btn-secondary o_hoja_carga_boton"
                        invisible="estado != 'sin_marcar'" context="{'cantidad_vista': total}"/>
                <button name="action_acomodado" type="object" string="Por acomodar" title="Por acomodar"
                        class="btn-secondary o_hoja_carga_boton o_hoja_carga_por_acomodar"
                        invisible="estado != 'agregado'" context="{'cantidad_vista': total}"/>
                <button name="action_quitar" type="object" string="Acomodado" title="Acomodado"
                        class="btn-success o_hoja_carga_boton"
                        invisible="estado != 'acomodado'"/>
            </list>
        </field>
    </record>

    <record id="hoja_carga_view_search" model="ir.ui.view">
        <field name="name">duran.hoja.carga.search</field>
        <field name="model">duran.hoja.carga</field>
        <field name="arch" type="xml">
            <search string="Hoja de carga">
                <field name="zona_id"/>
            </search>
        </field>
    </record>

    <record id="hoja_carga_action" model="ir.actions.act_window">
        <field name="name">Hoja de carga</field>
        <field name="res_model">duran.hoja.carga</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="hoja_carga_view_list"/>
        <field name="search_view_id" ref="hoja_carga_view_search"/>
        <field name="group_ids" eval="[Command.link(ref('sales_team.group_sale_manager'))]"/>
        <!-- Sin dominio: la vista SQL ya tiene solo lo pendiente (borra el de la
             versión anterior sobre stock.move). -->
        <field name="domain" eval="False"/>
        <field name="context">{'group_by': ['zona_id']}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay nada pendiente de cargar</p>
            <p>Aquí aparece, por zona y producto, todo lo pedido que falta por entregar.</p>
        </field>
    </record>

    <menuitem id="hoja_carga_menu"
        name="Hoja de carga"
        parent="sale.sale_order_menu"
        action="hoja_carga_action"
        groups="sales_team.group_sale_manager"
        sequence="5"/>

</odoo>
