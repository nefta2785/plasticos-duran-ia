# Variables de producción. Copia este archivo como .env en esta misma carpeta
# (docker/prod/.env, que NO se versiona) y cambia los valores CAMBIAR.
# Nunca subas el .env real a git ni lo pegues en un chat.

# Usuario y contraseña de PostgreSQL (los usa también Odoo para conectarse).
POSTGRES_USER=CAMBIAR
POSTGRES_PASSWORD=CAMBIAR

# Configuración de nginx que se monta: "http" (solo puerto 80, mientras no
# hay certificado) o "https" (80 + 443, cuando el certificado ya existe).
NGINX_CONF=http
