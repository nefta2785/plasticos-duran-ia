# ─────────────────────────────────────────────────────────────
# Credenciales de PostgreSQL para la instancia local de Odoo.
#
# Copia este archivo a docker/.env y rellena los valores:
#   cd docker && cp .env.example .env
#
# docker/.env está ignorado por git (patrón .env en el .gitignore de la raíz).
# Este .env.example SÍ se versiona: no pongas aquí valores reales.
# ─────────────────────────────────────────────────────────────

# Rol y contraseña de PostgreSQL.
# Los usa el servicio "db" (POSTGRES_USER / POSTGRES_PASSWORD) para crear el
# rol, y el servicio "odoo" (USER / PASSWORD) para conectarse con él.
POSTGRES_USER=
POSTGRES_PASSWORD=

# Base de datos de mantenimiento a la que Odoo se conecta al arrancar.
# Déjalo en "postgres" (no es un secreto): Odoo crea su propia base de datos
# del negocio desde el gestor web la primera vez que entras.
POSTGRES_DB=postgres
